# Supabase connection parameters (used by Python scripts)
# Use 127.0.0.1 instead of localhost: on Windows, localhost resolves to IPv6
# ::1 first, and Docker's IPv6 binding hangs until TCP timeout (~10s+). Using
# 127.0.0.1 skips DNS/IPv6 resolution and connects in <10ms. This matters for
# scripts that open multiple connections sequentially (e.g. stream_szse_price
# opens 5 — localhost added ~50s of startup delay).
SUPABASE_HOST=127.0.0.1
SUPABASE_PORT=9876
SUPABASE_DB=oxpicious-stats
SUPABASE_USER=postgres
SUPABASE_PASSWORD=postgres


SUPABASE_URL=http://localhost:8000
STUDIO_PORT=3000
AUTH_PORT=9999
REST_PORT=3001
REALTIME_PORT=4000
STORAGE_PORT=5000
EDGE_PORT=9000

JWT_SECRET=oxpicious-trading-agents-jwt-secret-key-2026
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im94cGljaXVzLWJyYXl0IiwiYXVkIjoiYW5vbnltb3VzIiwiaWF0IjoxNzE3MTk2ODAwLCJleHAiOjI0NDg3NTI4MDB9.-oxpicious-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im94cGljaXVzLWJyYXl0IiwiYXVkIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNzE3MTk2ODAwLCJleHAiOjI0NDg3NTI4MDB9.-oxpicious-service-role-key
